// cylinder between two points
module bar(p0, p1, r, seg = 48) {
    v = p1 - p0;
    ln = norm(v);
    translate(p0) rotate([0, acos(v[2] / ln), atan2(v[1], v[0])])
        cylinder(h = ln, r = r, $fn = seg);
}

